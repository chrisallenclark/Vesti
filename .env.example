# ─────────────────────────────────────────────────────────────────────────────
# Vesti environment. Copy to .env and fill in. NEVER commit .env.
#
# Role separation is a security boundary, not a convention. Each service gets
# the least-privileged connection string it can function with:
#
#   DATABASE_URL_APP        -> app_read        request path, no writes to orders
#   DATABASE_URL_RESEARCH   -> research_write  ingest + AI layer, cannot trade
#   DATABASE_URL_EXECUTION  -> execution_write ONLY writer of orders/fills
#   DATABASE_URL_BACKTEST   -> backtest_pit    PIT views only, no base fact reads
#
# The web app must never be given the execution or backtest URLs.
# ─────────────────────────────────────────────────────────────────────────────

# Owner/superuser connection, used only by migrations and local tooling.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vesti

DATABASE_URL_APP=postgres://vesti_app:CHANGEME@localhost:5432/vesti
DATABASE_URL_RESEARCH=postgres://vesti_research:CHANGEME@localhost:5432/vesti
DATABASE_URL_EXECUTION=postgres://vesti_execution:CHANGEME@localhost:5432/vesti
DATABASE_URL_BACKTEST=postgres://vesti_backtest:CHANGEME@localhost:5432/vesti

# Role passwords consumed by the migration that provisions roles.
VESTI_APP_PASSWORD=CHANGEME
VESTI_RESEARCH_PASSWORD=CHANGEME
VESTI_EXECUTION_PASSWORD=CHANGEME
VESTI_BACKTEST_PASSWORD=CHANGEME

# ── Market data (Phase 2) ────────────────────────────────────────────────────
# Alpaca free tier: daily + 1-minute bars on the FULL consolidated tape (SIP),
# measured back to 2016-01-04. The free plan withholds only *recent* SIP -
# roughly the last 15 minutes - not SIP itself. Ingestion holds `end` behind
# that window automatically, so no configuration is needed to backfill.
#
# Leave ALPACA_FEED unset. It exists for one case: ALPACA_FEED=iex forces the
# partial IEX tape (~2-3% of consolidated volume), which is only the right
# choice for a real-time path where a 15-minute-old consolidated print is worse
# than a fresh partial one. Every bar records its tape, so a mixed history stays
# honest and recomputable.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# ALPACA_FEED=iex

# ── Broker (Phase 5+). Paper only until the L3 gate passes. ──────────────────
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# ── Evidence sources (Phase 7). All free; EDGAR requires a real contact. ─────
SEC_EDGAR_USER_AGENT="Vesti Research your-email@example.com"
OPENFDA_API_KEY=

# ── AI (Phase 8) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
VESTI_AI_DAILY_BUDGET_USD=5.00
VESTI_AI_MONTHLY_BUDGET_USD=60.00
