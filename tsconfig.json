{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // Everything here runs under tsx, which resolves `./foo.ts` directly, so the
    // source says what it means rather than importing a `.js` file that is never
    // built. Nothing in packages/ is compiled to disk.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // apps/web has its own config — Next needs DOM libs, JSX, and bundler
  // resolution, and folding those in here would silently relax the server
  // packages' settings too. `npm run typecheck` checks both.
  "include": ["packages/**/*.ts", "scripts/**/*.mts"],
  "exclude": ["node_modules", "dist", ".next", "apps"]
}
